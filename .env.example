# Supabase (projeto único, multi-tenant por loja_id)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Asaas — cada loja tem subconta própria; estas chaves são da conta mestre
# da Aurora, usada pra criar subcontas via API (spec seção 3).
ASAAS_API_KEY=
ASAAS_ENV=sandbox
ASAAS_AURORA_WALLET_ID=
ASAAS_WEBHOOK_TOKEN=

# true = usa lib/asaas/mock-client.ts (sem conta Asaas real, sem rede) e
# libera o botão "simular pagamento" na tela de acompanhamento do pedido —
# ver lib/asaas/provider.ts e app/api/dev/simular-pagamento-pix/. Nunca
# deixar "true" em produção.
NEXT_PUBLIC_ASAAS_MOCK=true

# Agente de texto do cardápio (spec seção 5)
ANTHROPIC_API_KEY=
